# OS and editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Secrets
.env
*.pem
credentials.json

# Machine-specific WoW path for scripts/scan-addons.ps1
scripts/addons.local.json

# Sheet write URL and secret. Public CSV URLs stay in data/sheet.json.
data/sheet.local.json
scripts/sheets/seed/

# Addon zips built by scripts/package-addon.ps1
dist/

# Private canonical data - LOCAL ONLY, never commit (Amendment 1).
# Canonical characters/collections/economy JSON holds gold, bags, bank,
# mail and ledger detail. Pages serves committed files directly, so a
# render-time redaction is not enough: private files must not be staged.
data/private/
exports/raw/
data/*.private.json

# Raw game data - never commit raw exports or SavedVariables copies.
**/SavedVariables/
*.savedvariables.lua
wtf/

# Local private outputs (Butler pack, workbook) when generated outside data/private/
outputs/
